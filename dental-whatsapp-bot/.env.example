# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=                 # token permanente de un usuario del sistema (no el temporal de 24 h)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=          # cadena que tú inventas; la pegas también en el panel de Meta
WHATSAPP_APP_SECRET=            # Meta > Configuración de la app > Básica > Clave secreta
STAFF_WHATSAPP=                 # (opcional) nº de recepción, solo dígitos, p. ej. 34911222333

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=             # ID del calendario de la clínica (Configuración del calendario > Integrar)
GOOGLE_SERVICE_ACCOUNT_JSON=    # ruta al .json o el contenido JSON completo

# --- Otros ---
DB_PATH=bot.db
# DEMO_MODE=1                   # agenda en memoria, sin Google (solo pruebas)
